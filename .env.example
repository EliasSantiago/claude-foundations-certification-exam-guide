# ---- Neon (Postgres) -------------------------------------------------------
# Connection string from your Neon project (or auto-injected by the Vercel
# Neon integration). Use the POOLED connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ---- Auth.js (NextAuth v5) -------------------------------------------------
# Secret used to sign session JWTs. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical URL of the app. In production set this to your deployed URL.
# Optional in local dev (defaults to http://localhost:3000).
# AUTH_URL="https://your-app.vercel.app"
